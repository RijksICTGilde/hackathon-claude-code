PROJECTS_DIR=./projects

# Authenticatie (optioneel, kan ook in de container via claude login)
# ANTHROPIC_API_KEY is alleen voor het API-plan (pay-per-use via console.anthropic.com)
# Bij een Max-abonnement gebruik je claude login in de container
# Voor GitHub: authenticeer binnen de container via `gh auth login` (token blijft
# bewaard in het claude-home volume — zie README)
ANTHROPIC_API_KEY=

# Optionele componenten (build-time toggles).
# Elke waarde moet exact 'true' of 'false' zijn (andere waardes laten de build falen).
# Verplicht bij gebruik van docker compose (compose.yml dwingt dit af via :?);
# bij een directe `docker build` gelden de Dockerfile-defaults (allemaal 'true').
# Geen spaties rond het '=' teken.

# SDKman voor JVM-talen (Java, Kotlin). Vereist ook voor de LSP-plugins
# (samen met INSTALL_ANTHROPIC_PLUGINS=true).
INSTALL_JVM=true

# rtk (reduce token use) + auto-patch.
INSTALL_RTK=true

# Developer Overheid NL plugins (standaarden, developer-overheid, nerds,
# internet). De geo- en zad-actions-plugins staan los achter eigen toggles
# omdat hun skill-bundels relatief veel context-budget kosten.
INSTALL_OVERHEID_PLUGINS=true

# Losse geo-plugin (Geonovum geo-standaarden). Standaard uit om context-budget
# te sparen; zet op true als je actief met geo-standaarden werkt.
INSTALL_OVERHEID_GEO=false

# Losse zad-actions-plugin (GitHub Actions voor Nederlandse overheid). Standaard
# uit om context-budget te sparen; zet op true als je ZAD-workflows ontwikkelt.
INSTALL_OVERHEID_ZAD_ACTIONS=false

# Anthropic plugins (github, pr-review-toolkit, commit-commands, superpowers,
# feature-dev, claude-md-management, code-review, code-simplifier,
# security-guidance, claude-code-setup, ralph-loop). LSP-plugins komen er
# ook bij als INSTALL_JVM=true.
INSTALL_ANTHROPIC_PLUGINS=true

# Lokale skills uit de skills/ directory (digital-waste-spotter).
INSTALL_LOCAL_SKILLS=true

# caveman plugin (third-party, https://github.com/JuliusBrussee/caveman):
# ultra-compressed communicatie-modus, snijdt ~75% tokens.
INSTALL_CAVEMAN=true

# Rootless Podman in de container: Maven+Testcontainers nested draaien (issue
# #44). Default false. Bij true is ook de runtime-override nodig voor
# seccomp/apparmor + netwerk — zie claude-sandbox/podman/README.md. Zodra podman
# in de image zit (INSTALL_PODMAN=true) voegt init-firewall.sh de
# docker.io-registries automatisch aan de firewall-whitelist toe wanneer
# OPEN_HTTPS=false, dus die hoef je niet handmatig in ALLOWED_DOMAINS te zetten.
# Gebruik je een eigen/interne registry (Harbor, Nexus, mirror), zet die dan wél
# in ALLOWED_DOMAINS.
INSTALL_PODMAN=false

# Multi-uid rootless podman: zet een subuid-range voor `claude` in de image.
# Nodig voor images die naar een tweede uid chownen (postgres, mysql, mariadb en
# de meeste DB-images) — in de default single-uid modus falen die met
# `chown: ...: Invalid argument`. Vereist bij true óók
# compose.override.podman-multiuid.yml (CAP_SYS_ADMIN), gestapeld op je
# platform-override. Lees eerst de afweging in die override: het vergroot de
# impact van een root-escalatie ín de container.
PODMAN_MULTIUID=false

# Uitgaand HTTPS-verkeer uit de sandbox.
#   true  — al het uitgaand verkeer over 443 is toegestaan.
#           ALLOWED_DOMAINS doet dan NIETS.
#   false — alleen de domeinen uit ALLOWED_DOMAINS zijn bereikbaar; de rest
#           wordt door de firewall geweigerd.
# Haal je deze regel wég, dan valt init-firewall.sh terug op false. Ontbreken
# van de variabele maakt de sandbox dus stránger, niet losser.
# De default staat op true omdat de meeste hackathon-opdrachten packages,
# registries en documentatie van wisselende domeinen halen. Zet hem op false als
# je wil kunnen aantonen waar de sandbox naartoe praat — bijvoorbeeld bij werk
# met gevoelige code, of om te zien wat een agent probeert te bereiken.
OPEN_HTTPS=true

# Domein-allowlist. Wordt alleen toegepast als OPEN_HTTPS=false; bij de default
# true is deze regel een no-op. Kommagescheiden, zonder schema of pad.
# Subdomeinen moet je los toevoegen.
#
# Draai je met INSTALL_PODMAN=true, dan zet init-firewall.sh de
# container-registries die Testcontainers nodig heeft er automatisch bij. Een
# eigen of interne registry (Harbor, Nexus, een mirror) moet je hier wél zelf
# opnemen.
#
# De allowlist wordt gelezen vóór de privilege-drop bij container-start. Je kunt
# hem dus niet vanuit de draaiende sandbox aanpassen — een wijziging vereist
# `docker compose up -d --force-recreate`.
ALLOWED_DOMAINS=developer.overheid.nl,internet.nl,geonovum.nl,logius.nl,standaarden.overheid.nl

# Verversen van geïnstalleerde marketplaces bij elke container-start, zodat
# plugin-bundels up-to-date blijven zonder image-rebuild. Niet-fataal: bij
# netwerk-/upstream-failure waarschuwt de container en draait door.
MARKETPLACE_AUTOUPDATE=true
